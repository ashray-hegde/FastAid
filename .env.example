# Backend
MONGO_URI=mongodb://localhost:27017/fastaid
JWT_SECRET=replace_this_with_a_secure_random_value
FRONTEND_URL=http://localhost:3000

# Twilio (optional - enable SMS OTP in production)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# Frontend (optional Firebase phone auth - not required if using Twilio backend)
# In frontend/.env set REACT_APP_FIREBASE_API_KEY and others if you want to use Firebase phone auth
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_APP_ID=
